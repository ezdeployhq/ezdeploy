# Control plane deployment provider
ZAODEPLOY_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ZAODEPLOY_DATABASE_PATH=.zaodeploy/control-plane.db
ZAODEPLOY_SOURCE_ROOT=.zaodeploy/sources

# Central control-plane authentication: JSON map of SHA-256 token hash to employee ID
ZAODEPLOY_MCP_TOKEN_HASHES={}
ZAODEPLOY_ADMIN_OWNER_IDS=

# Generate with: openssl rand -base64 32
ZAODEPLOY_ENCRYPTION_KEY=
ZAODEPLOY_SECRETS_PATH=.zaodeploy/secrets

# Optional AI binding issuer
ZAODEPLOY_AI_PROXY_URL=
ZAODEPLOY_AI_CONTROL_TOKEN=
ZAODEPLOY_AI_MODELS=default-chat
ZAODEPLOY_AI_RPM=60

# Optional organization access
CLOUDFLARE_ACCESS_ENABLED=false
CLOUDFLARE_ACCESS_EMAIL_DOMAIN=
CLOUDFLARE_ACCESS_SERVICE_TOKEN_IDS=
CLOUDFLARE_ACCESS_SERVICE_CLIENT_ID=
CLOUDFLARE_ACCESS_SERVICE_CLIENT_SECRET=

# Application center: local token mode or Cloudflare Access header mode
ZAODEPLOY_APP_CENTER_TOKEN=
ZAODEPLOY_TRUST_CLOUDFLARE_ACCESS=false

# Employee-side Agent Gateway only; do not give it Cloudflare or model-provider keys
ZAODEPLOY_CONTROL_PLANE_URL=
ZAODEPLOY_CONTROL_PLANE_TOKEN=
ZAODEPLOY_ACCESS_CLIENT_ID=
ZAODEPLOY_ACCESS_CLIENT_SECRET=
ZAODEPLOY_CONNECTION_KEY=
