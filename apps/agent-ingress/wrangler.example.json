{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ezdeploy-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "services": [{
    "binding": "CONTROL_PLANE",
    "service": "ezdeploy-control-plane"
  }],
  "vars": {
    "APP_CENTER_URL": "https://apps.example.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "deploy.apps.example.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
