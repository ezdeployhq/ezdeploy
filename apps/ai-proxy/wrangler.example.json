{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ezdeploy-ai-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ezdeploy-control",
    "database_id": "YOUR_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "AI_GATEWAY_BASE_URL": "https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1",
    "AI_GATEWAY_ID": "default",
    "MODEL_ALIASES": "{\"default-chat\":\"@cf/openai/gpt-oss-120b\",\"embedding\":\"@cf/baai/bge-large-en-v1.5\"}"
  }
}
