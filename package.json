{
  "name": "ezdeploy",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-native personal application deployment center",
  "homepage": "https://github.com/jingchang0623-crypto/ezdeploy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jingchang0623-crypto/ezdeploy.git"
  },
  "bugs": {
    "url": "https://github.com/jingchang0623-crypto/ezdeploy/issues"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:agent-client": "node scripts/build-agent-client.mjs",
    "build:examples": "npm --workspaces --if-present run build --include-workspace-root=false",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "preflight:cloudflare": "node scripts/cloudflare-preflight.mjs",
    "setup:cloudflare": "node scripts/cloudflare-setup.mjs",
    "smoke:cloudflare": "npm run build && node scripts/cloudflare-smoke.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
